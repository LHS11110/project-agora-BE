server {
    listen 443 ssl;
    server_name _;

    ssl_certificate /home/ubuntu/github/project-agora-BE/nginx/ssl/cert.pem;
    ssl_certificate_key /home/ubuntu/github/project-agora-BE/nginx/ssl/key.pem;

    # Local C++ instances use distinct WS ports. Only the configured 8002-8099
    # range is accepted, preventing this endpoint from becoming an open proxy.
    location ~ ^/wss/port/(?<cpp_ws_port>80(?:0[2-9]|[1-9][0-9]))/canvas/(?<canvas_id>[0-9]+)$ {
        proxy_pass http://127.0.0.1:$cpp_ws_port/ws/canvas/$canvas_id$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}

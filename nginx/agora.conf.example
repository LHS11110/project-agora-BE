server {
    server_tokens off;
    listen 80;
    server_name _;
    
    # HTTP 요청을 HTTPS로 리디렉션
    return 301 https://$host$request_uri;
}

server {
    server_tokens off;
    listen 443 ssl;
    server_name _;

    # Use a CA-issued certificate in production. Keep the private key outside
    # the application checkout and readable only by root.
    ssl_certificate /etc/nginx/ssl/agora/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/agora/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Spring Boot API 라우팅
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # React/Vite frontend build. Copy the contents of project-agora-FE/dist/
    # to /var/www/agora-frontend/ during deployment; do not expose the source
    # checkout under /home, which is not traversable by the nginx worker.
    root /var/www/agora-frontend;
    index index.html;

    # Vite assets must return 404 when missing, not the SPA HTML fallback.
    # This also prevents CSS/JS requests from receiving Spring JSON/HTML MIME types.
    location /assets/ {
        try_files $uri =404;
    }

    # Client-side routes (/, /login, /canvas/:id, /search, /profile).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # C++ 서버 WebSocket 라우팅
    # Local C++ instances use distinct WS ports. Only the configured 8002-8099
    # range is accepted, preventing this endpoint from becoming an open proxy.
    location ~ ^/wss/port/(?<cpp_ws_port>80(?:0[2-9]|[1-9][0-9]))/rtc/canvas/(?<canvas_id>[0-9]+)$ {
        proxy_pass http://127.0.0.1:$cpp_ws_port/ws/rtc/canvas/$canvas_id$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location ~ ^/wss/port/(?<cpp_ws_port>80(?:0[2-9]|[1-9][0-9]))/canvas/(?<canvas_id>[0-9]+)$ {
        proxy_pass http://127.0.0.1:$cpp_ws_port/ws/canvas/$canvas_id$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}

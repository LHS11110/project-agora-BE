# Single Nginx configuration, owned by project-agora-BE.
# Mounted as /etc/nginx/templates/default.conf.template by the Nginx Compose.
# FRONTEND_MODE is production or development; Docker substitutes it at startup.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
map "${FRONTEND_MODE}" $frontend_root {
    default /usr/share/nginx/html;
    development /var/empty/agora;
}
map "${FRONTEND_MODE}" $spa_fallback {
    default /index.html;
    development @vite;
}
map "${FRONTEND_MODE}" $asset_cache {
    default "public, max-age=31536000, immutable";
    development "no-cache";
}

server {
    server_tokens off;
    listen 80;
    server_name _;
    resolver 127.0.0.11 valid=30s ipv6=off;
    root $frontend_root;
    index index.html;

    # For public HTTPS, mount CA-issued certificates using this Compose and
    # enable these lines, publish 443:443, and redirect HTTP to HTTPS.
    # listen 443 ssl;
    # ssl_certificate /etc/nginx/ssl/agora/fullchain.pem;
    # ssl_certificate_key /etc/nginx/ssl/agora/privkey.pem;
    # ssl_protocols TLSv1.2 TLSv1.3;
    # add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location /api/ {
        set $spring_host agora-spring;
        proxy_pass http://$spring_host:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Only WS ports 8002-8099 are accepted; C++ REST is never exposed here.
    location ~ ^/wss/port/(?<cpp_ws_port>80(?:0[2-9]|[1-9][0-9]))/(?<cpp_ws_path>(?:rtc/)?canvas/[0-9]+)$ {
        set $cpp_host agora-cpp;
        proxy_pass http://$cpp_host:$cpp_ws_port/ws/$cpp_ws_path$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        access_log off; # Canvas access tokens are in the query string.
    }
    location /wss/ { return 404; }

    location = /index.html {
        try_files $uri @vite;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }
    location /assets/ {
        try_files $uri @vite;
        add_header Cache-Control $asset_cache;
    }
    location ~ \.mjs$ {
        try_files $uri @vite;
        types { application/javascript mjs; }
        add_header Cache-Control $asset_cache;
    }
    location /pdfjs/ {
        try_files $uri @vite;
        types {
            application/wasm wasm;
            application/javascript js mjs;
            application/json json;
        }
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=86400";
    }
    location /mathjax/ {
        try_files $uri @vite;
        add_header Cache-Control "public, max-age=86400";
    }
    location / {
        try_files $uri $uri/ $spa_fallback;
    }
    location @vite {
        # A missing production asset must not return the SPA HTML.
        if ("${FRONTEND_MODE}" != "development") { return 404; }
        set $vite_host agora-frontend-dev;
        proxy_pass http://$vite_host:5173;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
    }
}

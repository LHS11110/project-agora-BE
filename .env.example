# Run scripts/setup-docker.py to prepare .env and synchronize DB credentials.
# Certificates are supplied manually; never commit keys or generated .env files.
APP_ENV=development
NGINX_TLS_CERT_DIR=
NGINX_HTTPS_PORT=8443
NGINX_BACKEND_IP=172.23.0.250
CORS_ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
# Optional isolated VS Code extension host, e.g. https://*.ide.example.com:8080
CORS_ALLOWED_ORIGIN_PATTERNS=
AGORA_DB_DIR=

JWT_SECRET=change-me-with-a-random-shared-secret
CPP_INTERNAL_API_TOKEN=change-me-with-a-random-internal-token

DB_HOST=127.0.0.1
DB_PORT=1433
DOCKER_DB_HOST=agora-mssql
DOCKER_DB_PORT=1433
DB_NAME=agora_db
DB_USER=agora_user
DB_PASSWORD=change-me-from-db-configuration
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_MULTI_SUBNET_FAILOVER=false
SQL_TLS_CA_CERT=
CPP_FREETDS_CONF_HOST_PATH=./cpp/config/freetds-docker-tls.conf
DB_FREETDS_CONF=./cpp/config/freetds-docker-tls.conf

ES_HOST=127.0.0.1
ES_PORT=9200
DOCKER_ES_HOST=agora-elasticsearch
DOCKER_ES_PORT=9200
ES_SCHEME=https
ES_CA_CERT=
ES_INDEX=canvas
ES_USER_NAME=agora_user
ES_USER_PASSWORD=change-me-from-db-configuration
ES_LOG_INDEX=agora-logs
ES_LOG_USER_NAME=agora_log_writer
ES_LOG_USER_PASSWORD=change-me-from-db-configuration

REDIS_USER=agora_user
REDIS_USER_PASSWORD=change-me-from-db-configuration
REDIS_SENTINELS=172.20.0.6:26379,172.20.0.3:26379,172.20.0.4:26379
REDIS_SENTINEL_MASTER_NAME=agora-master
REDIS_SENTINEL_USER=agora_sentinel
REDIS_SENTINEL_PASSWORD=change-me-from-db-configuration
REDIS_TLS_ENABLED=true
REDIS_TLS_CA_CERT=

SERVICE_TLS_CERT=
SERVICE_TLS_KEY=
SERVICE_TLS_CA=

# Internal Wall Nginx listener; never use a C++ address here.
WALL_CPP_API_ORIGIN=https://agora-nginx:8444

# Wall creates an isolated service network; storage networks are separate.
AGORA_SERVICES_SUBNET=172.23.0.0/16
REDIS_BROKER_ROUTES=

# Metadata-only Korean BM25 + local E5 kNN search
ES_SEARCH_INDEX=canvas-search
ES_SEMANTIC_SEARCH_ENABLED=true
ES_SEARCH_LIMIT=100
ES_SEARCH_CANDIDATES=500
ES_SEARCH_MIN_SIMILARITY=0.80
SEARCH_EMBEDDING_URL=https://agora-nginx:8444/internal/search/embedding
SEARCH_SYNC_SECONDS=30
EMBEDDING_THREADS=2

GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://frelog.p-e.kr/api/auth/oauth2/callback/google

# Base64 of a persistent random 32-byte key; keep secret and back up securely.
MFA_ENCRYPTION_KEY=

# SMTP submission only; no inbound mail port is opened.
# 587: MAIL_SECURITY=starttls; 465: MAIL_SECURITY=ssl.
# MAIL_FROM must be a sender authorized by your mail provider.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SECURITY=starttls
EMAIL_VERIFICATION_SECRET=

# WebAuthn domain and exact browser origin (public configuration, no vendor secret).
PASSKEY_RP_ID=frelog.p-e.kr
PASSKEY_ORIGIN=https://frelog.p-e.kr

# naver OAuth: keep disabled until vendor credentials/callback are configured.
NAVER_OAUTH_ENABLED=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://frelog.p-e.kr/api/auth/oauth2/callback/naver

# kakao OAuth: keep disabled until vendor credentials/callback are configured.
KAKAO_OAUTH_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://frelog.p-e.kr/api/auth/oauth2/callback/kakao

# Private IRADE ORCID config; Compose reads this file raw and never substitutes its secret.
# Keep it outside the checkout, owned by the operator with mode 0600.
ORCID_ENV_FILE=/home/steam/.config/irade/orcid.env

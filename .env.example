# Run scripts/setup-docker.py to prepare .env and synchronize DB credentials.
# Certificates are supplied manually; never commit keys or generated .env files.
APP_ENV=development
NGINX_TLS_CERT_DIR=
NGINX_HTTPS_PORT=8443
NGINX_BACKEND_IP=172.21.0.250
CORS_ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
AGORA_DB_DIR=

JWT_SECRET=change-me-with-a-random-shared-secret
CPP_INTERNAL_API_TOKEN=change-me-with-a-random-internal-token
ADMIN_PASSWORD=change-me-with-a-strong-admin-password

DB_HOST=127.0.0.1
DB_PORT=1433
DOCKER_DB_HOST=agora-mssql
DOCKER_DB_PORT=1433
DB_NAME=agora_db
DB_USER=agora_user
DB_PASSWORD=change-me-from-db-configuration
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_MULTI_SUBNET_FAILOVER=false
SQL_TLS_CA_CERT=
CPP_FREETDS_CONF_HOST_PATH=./cpp/config/freetds-docker-tls.conf
DB_FREETDS_CONF=./cpp/config/freetds-docker-tls.conf

ES_HOST=127.0.0.1
ES_PORT=9200
DOCKER_ES_HOST=agora-elasticsearch
DOCKER_ES_PORT=9200
ES_SCHEME=https
ES_CA_CERT=
ES_INDEX=canvas
ES_USER_NAME=agora_user
ES_USER_PASSWORD=change-me-from-db-configuration
ES_LOG_INDEX=agora-logs
ES_LOG_USER_NAME=agora_log_writer
ES_LOG_USER_PASSWORD=change-me-from-db-configuration

REDIS_USER=agora_user
REDIS_USER_PASSWORD=change-me-from-db-configuration
REDIS_SENTINELS=172.20.0.6:26379,172.20.0.3:26379,172.20.0.4:26379
REDIS_SENTINEL_MASTER_NAME=agora-master
REDIS_SENTINEL_USER=agora_sentinel
REDIS_SENTINEL_PASSWORD=change-me-from-db-configuration
REDIS_TLS_ENABLED=true
REDIS_TLS_CA_CERT=

SERVICE_TLS_CERT=
SERVICE_TLS_KEY=
SERVICE_TLS_CA=

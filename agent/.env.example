# Server-side only. Never place this key in VITE_* or canvas objects.
# Optional server default keys per provider. Leave empty to require a personal key
# from each user for that provider. EXAONE is not supported: its API terms forbid
# integrating the API into products or services.
AGENT_OPENAI_API_KEY=
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=
AGENT_OPENROUTER_API_KEY=
AGENT_SOCKET=/run/agora-agent/agent.sock
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=8192
AGENT_REASONING_EFFORT=low
AGENT_TIMEOUT_SECONDS=210
AGENT_MAX_CONCURRENT=2
